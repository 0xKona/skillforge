{
    "name": "skillforge",
    "private": true,
    "workspaces": ["frontend", "infra"],
    "scripts": {
        "dev": "bun run --cwd frontend dev",
        "build": "bun run --cwd frontend build",
        "start": "bun run --cwd frontend start",
        "lint": "bun run --cwd frontend lint",
        "format": "prettier --write .",
        "test": "bun run --cwd frontend test",
        "test:verbose": "bun run --cwd frontend testv",
        "type-check": "bun run --cwd frontend type-check",
        "frontend:dev": "bun run --cwd frontend dev",
        "frontend:build": "bun run --cwd frontend build",
        "frontend:test": "bun run --cwd frontend test",
        "infra:synth": "bun run --cwd infra synth",
        "infra:deploy:test": "bun run --cwd infra deploy:test",
        "infra:deploy:prod": "bun run --cwd infra deploy:prod",
        "infra:diff": "bun run --cwd infra diff"
    }
}
