{
    "name": "skillforge",
    "private": true,
    "workspaces": [
        "frontend",
        "infra"
    ],
    "scripts": {
        "dev": "bun run --cwd frontend dev",
        "build": "bun run --cwd frontend build",
        "start": "bun run --cwd frontend start",
        "test": "bun run --cwd frontend test && bun run --cwd infra test",
        "test:frontend": "bun run --cwd frontend test",
        "test:infra": "bun run --cwd infra test",
        "test:verbose": "bun run --cwd frontend testv",
        "lint": "bun run --cwd frontend lint",
        "format": "prettier --write .",
        "type-check": "bun run --cwd frontend type-check",
        "infra:dev": "bun run --cwd infra dev",
        "infra:synth": "bun run --cwd infra synth",
        "infra:diff": "bun run --cwd infra diff",
        "infra:pipeline": "bun run --cwd infra deploy:pipeline",
        "infra:config:dev": "cd infra && npx ts-node scripts/generate-frontend-env.ts dev",
        "prepare": "husky"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.102.2"
    },
    "lint-staged": {
        "frontend/src/**/*.{ts,tsx}": [
            "prettier --write",
            "bun run --cwd frontend eslint --fix --no-warn-ignored"
        ],
        "infra/**/*.ts": [
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6"
    }
}
